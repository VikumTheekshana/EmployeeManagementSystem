# Server Port
PORT=5000

# MongoDB Atlas Connection URI (M0 Free Tier connection pooled)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/hrms_db?retryWrites=true&w=majority&appName=EmployeeManagementSystem&compressors=zlib

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here

# AES-256-GCM Master Encryption Key (32-byte hex or at least 32 characters)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client Origin
CLIENT_URL=http://localhost:3000

# Environment Mode
NODE_ENV=development
